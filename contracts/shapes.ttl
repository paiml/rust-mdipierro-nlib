        sh:path <https://ont.paiml.dev/v1alpha1/ex/plant_run> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "none" ) ;
    ] ;
.

<https://ont.paiml.dev/v1alpha1/shape/example-fourier-v1> a sh:NodeShape ;
    sh:targetClass <https://ont.paiml.dev/v1alpha1/ex/FourierReceipt> ;
    sh:closed true ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/ex/example> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "fourier" ) ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/ex/source> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "examples/fourier.rs" ) ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/ex/contract> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "example-fourier-v1" ) ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/ex/n_checks> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "6"^^<http://www.w3.org/2001/XMLSchema#integer> ) ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/ex/all_pass> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/ex/checks> ;
        sh:minCount 6 ;
        sh:maxCount 6 ;
        sh:node <https://ont.paiml.dev/v1alpha1/shape/example-fourier-v1/node> ;
    ] ;
.

<https://ont.paiml.dev/v1alpha1/shape/example-fourier-v1/node> a sh:NodeShape ;
