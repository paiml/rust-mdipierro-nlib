@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ont: <https://ont.paiml.dev/v1alpha1/> .

<https://ont.paiml.dev/v1alpha1/shape/enforcement-claims-v1> a sh:NodeShape ;
    sh:targetClass <https://ont.paiml.dev/v1alpha1/ex/EnforcementClaims> ;
    sh:closed true ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/ex/schema> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "enforcement-claims-v1" ) ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/ex/ruleset> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "Green Main" ) ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/ex/required_check> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "gate" ) ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/ex/enforced> ;
        sh:minCount 1 ;
        sh:node <https://ont.paiml.dev/v1alpha1/shape/enforcement-claims-v1/node> ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/ex/unplanted> ;
        sh:minCount 0 ;
        sh:node <https://ont.paiml.dev/v1alpha1/shape/enforcement-claims-v1/node> ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/ex/not_enforced> ;
        sh:minCount 1 ;
        sh:node <https://ont.paiml.dev/v1alpha1/shape/enforcement-claims-v1/node> ;
    ] ;
.

<https://ont.paiml.dev/v1alpha1/shape/enforcement-claims-v1/node> a sh:NodeShape ;
    sh:closed true ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/ex/id> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:pattern "^CLAIM-[0-9]{3}$" ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/ex/claim> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minLength 1 ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/ex/mechanism> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minLength 1 ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/ex/red_when> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minLength 1 ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/ex/limit> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minLength 1 ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/ex/job> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "gate" "lint-test" "golden-vectors" "parity" "kani" "mutants" "examples" "contracts" ) ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/ex/blocks_merge> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/ex/required_check> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "gate" ) ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/ex/plant> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minLength 20 ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/ex/plant_run> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:pattern "^https://github\\.com/paiml/rust-mdipierro-nlib/actions/runs/[0-9]+/job/[0-9]+$" ;
    ] ;
.

<https://ont.paiml.dev/v1alpha1/shape/enforcement-claims-v1/node> a sh:NodeShape ;
