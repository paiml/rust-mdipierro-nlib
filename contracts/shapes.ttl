    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/ex/job> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "comply" "none" ) ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/ex/blocks_merge> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ) ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/ex/required_check> ;
        sh:minCount 1 ;
